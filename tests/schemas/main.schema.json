{
  "$id": "schema:workflow/main",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "RUN": {
      "$ref": "./tests/schemas/run.schema.json"
    },
    "EXPERIMENT": {
      "$ref": "./tests/schemas/experiment.schema.json"
    },
    "REQUEST": {
      "$ref": "./tests/schemas/request.schema.json"
    },
    "CONFIGURATION": {
      "$ref": "./tests/schemas/configuration.schema.json"
    },
    "GSV": {
      "$ref": "./tests/schemas/gsv.schema.json"
    },
    "JOBS": {
      "$ref": "./tests/schemas/jobs.schema.json"
    },
    "PLATFORMS": {
      "$ref": "./tests/schemas/platforms.schema.json"
    }
  },
  "required": [
    "RUN",
    "EXPERIMENT",
    "REQUEST",
    "CONFIGURATION"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "CONFIGURATION": {
            "properties": {
              "ADDITIONAL_JOBS": {
                "properties": {
                  "AQUA": { "const": "True" }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "AQUA": {
            "$ref": "./tests/schemas/aqua.schema.json"
          }
        },
        "required": ["AQUA"]
      }
    },
    {
      "if": {
        "properties": {
          "MODEL": {
            "properties": {
              "NAME": { "not": { "const": "icon" } }
            },
            "required": ["NAME"]
          },
          "RUN": {
            "properties": {
              "WORKFLOW": { "enum": ["model", "end-to-end"] }
            },
            "required": ["WORKFLOW"]
          }
        },
        "required": ["MODEL", "RUN"]
      },
      "then": {
        "properties": {
          "CONFIGURATION": {
            "properties": {
              "IFS": {
                "required": ["GTYPE", "RESOL", "LEVELS", "EXPVER", "LABEL", "IO_NODES"]
              }
            },
            "required": ["IFS"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "CONFIGURATION": {
            "properties": {
              "ADDITIONAL_JOBS": {
                "properties": {
                  "CLEAN_RESTARTS": { "const": "True" }
                },
                "required": ["CLEAN_RESTARTS"]
              }
            },
            "required": ["ADDITIONAL_JOBS"]
          }
        },
        "required": ["CONFIGURATION"]
      },
      "then": {
        "properties": {
          "CONFIGURATION": {
            "properties": {
              "RESTARTS": {
                "required": ["KEEP_EVERY", "KEEP_LAST"]
              }
            },
            "required": ["RESTARTS"]
          }
        }
      }
    }
  ]
}
