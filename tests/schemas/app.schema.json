{
  "$id": "schema:workflow/app",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "App",
  "description": "Schema for the app section of the workflow",
  "properties": {
    "ENERGY_INDICATORS": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If energy indicators enabled"
    },
    "ENERGY_INDICATORS_WRAPPER": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If the energy indicators wrapper is enabled"
    },
    "ENERGY_OFFSHORE": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If energy offshore enabled"
    },
    "ENERGY_OFFSHORE_WRAPPER": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If the energy offshore wrapper is enabled"
    },
    "HYDROLAND": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If hydroland enabled"
    },
    "HYDROLAND_WRAPPER": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If the hydroland wrapper is enabled"
    },
    "HYDROMET": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If hydromet enabled"
    },
    "HYDROMET_WRAPPER": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If the hydromet wrapper is enabled"
    },
    "WILDFIRES_FWI": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If wildfires FWI enabled"
    },
    "WILDFIRES_FWI_WRAPPER": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If the wildfires FWI wrapper is enabled"
    },
    "WILDFIRES_WISE": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If wildfires WISE enabled"
    },
    "WILDFIRES_WISE_WRAPPER": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If the wildfires WISE wrapper is enabled"
    },
    "OBSALL": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If OBSALL enabled"
    },
    "OBSALL_WRAPPER": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If the OBSALL wrapper is enabled"
    },
    "DATA": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If data workflow enabled"
    },
    "OUTPATH": {
      "type": "string",
      "description": "Path to the output directory"
    },
    "READ_FROM_DATABRIDGE": {
      "type": "string",
      "enum": ["False", "True"],
      "description": "If the data will be read from the databridge"
    }
  },
  "required": ["OUTPATH"]
}
